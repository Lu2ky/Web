{
  "name": "horarios-estudiantes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:profile-preferences": "vitest run src/components/Account/UserPreferences.test.jsx",
    "test:comments:unit": "vitest run src/components/Calendar/PopUpClasses.add-comment.test.jsx src/components/Calendar/PopUpClasses.remove-comment.test.jsx",
    "test:e2e": "playwright test",
    "test:e2e:run": "playwright test tests/e2e/user-profile-change-password.e2e.spec.js",
    "test:e2e:real": "playwright test -c playwright.real.config.js tests/e2e/user-profile-change-password.real-persistence.e2e.spec.js",
    "test:e2e:security": "playwright test tests/e2e/user-profile-change-password.security.e2e.spec.js",
    "test:password:local": "node scripts/run-local-password-validation.mjs",
    "test:perf:password": "artillery run tests/performance/change-password.artillery.yml",
    "test:perf:password:report": "node -e \"console.log('Artillery report fue deprecado; revisa tests/evidencia/mi-perfil-cambio-contrasena-rendimiento.txt y .json')\"",
    "test:theme:unit": "vitest run src/components/ControlBar/ThemeSelector.test.jsx",
    "test:theme:e2e": "playwright test tests/e2e/theme-selector.e2e.spec.js",
    "test:theme:perf": "node tests/performance/theme-selector-performance.mjs",
    "test:theme:perf:artillery": "artillery run tests/performance/theme-selector.artillery.yml",
    "test:theme:full": "npm run test:theme:unit && npm run test:theme:e2e && npm run test:theme:perf"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "artillery": "^2.0.22",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
