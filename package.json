{
  "name": "horarios-estudiantes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility.e2e.spec.js",
    "test:e2e:login": "playwright test tests/e2e/login-security.e2e.spec.js",
    "test:e2e:logout": "playwright test tests/e2e/logout.security.e2e.spec.js",
    "test:e2e:notifications": "playwright test tests/e2e/notifications-mute.e2e.spec.js",
    "test:e2e:notifications:security": "playwright test tests/e2e/notifications-mute.security.e2e.spec.js",
    "test:e2e:profile": "playwright test tests/e2e/user-profile-change-password.e2e.spec.js",
    "test:e2e:profile:security": "playwright test tests/e2e/user-profile-change-password.security.e2e.spec.js",
    "test:e2e:profile:real": "playwright test -c playwright.real.config.js tests/e2e/user-profile-change-password.real-persistence.e2e.spec.js",
    "test:password:local": "node scripts/run-local-password-validation.mjs",
    "test:perf:password": "artillery run tests/performance/change-password.artillery.yml"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "motion": "^14.6.0",
    "react": "^19.2.0",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "artillery": "^2.0.22",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
