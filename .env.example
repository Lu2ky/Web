# ============================================
# VARIABLES DE ENTORNO - PLANTILLA
# ============================================
# Copia este archivo a .env.local para desarrollo local
# O proporciona las variables a través de docker-compose.yml

# -------- Variables Requeridas --------

# Dirección del servidor API
API_ADDR=localhost

# Puerto del servidor API
API_PORT=28523

# -------- Variables Autogeneradas --------
# Las siguientes variables se generan automáticamente desde API_ADDR y API_PORT
# usando el script scripts/generate-env.js
# 
# NO necesitas definirlas manualmente a menos que quieras valores específicos:

# VITE_API_URL_LDAP
# VITE_API_URL_OFICIAL_SCHEDULE
# VITE_API_URL_PERSONAL_SCHEDULE
# VITE_API_URL_COURSE_TYPES
# VITE_API_ADD_PERSONAL_ACTIVITY
# VITE_API_UPDATE_PERSONAL_ACTIVITY
# VITE_API_DELETE_PERSONAL_ACTIVITY
# VITE_API_URL_COMMENTS
# VITE_API_ADD_COMMENT
# VITE_API_UPDATE_COMMENT
# VITE_API_DELETE_COMMENT
# VITE_API_URL_TAGS_USER
# VITE_API_URL_TAGS_REMINDER
# VITE_API_DELETE_TAGS_REMINDER
# VITE_API_URL_REMINDERS_USER
# VITE_API_ADD_REMINDER
# VITE_API_DELETE_REMINDER
# VITE_API_UPDATE_REMINDER
# VITE_API_UPDATE_DESCRIPTION_REMINDER
# VITE_API_UPDATE_DATE_REMINDER
# VITE_API_UPDATE_PRIORITY_REMINDER
