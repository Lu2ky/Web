# UPB Planner Web — variables de entorno
# Copiar a `.env` para desarrollo local.

# Única URL base de la API. Relativa por defecto: Vite (dev) y nginx (prod)
# la resuelven contra api-express. La API key la inyecta api-express.
VITE_API_BASE_URL=/api/v1

# App config
VITE_APP_NAME=UPB Planner
VITE_APP_VERSION=2.0.0
